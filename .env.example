# Firebase Configuration
# Get these values from your Firebase project console at https://console.firebase.google.com
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Gemini AI Configuration (Optional - for AI features)
# Get your API key from https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Magic Hour AI Configuration (Optional - for complete AI meme generation)
# Get your API key from https://magichour.ai/developer?tab=api-keys
VITE_MAGIC_HOUR_API_KEY=your-magic-hour-api-key-here